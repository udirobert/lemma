---
import "../../styles/global.css";
import StatusBadge from "../../components/StatusBadge.astro";
import BgGlass from "../../components/BgGlass.astro";
import ClipMenu from "../../components/ClipMenu.astro";
import papersData from "../../data/papers.json";

const papers = papersData.papers;
const totals = papersData.totals;

// flattened cross-paper claim index for the explorer table
const claimRows = papers
  .flatMap((p: any) =>
    (p.claims ?? []).map((c: any) => ({
      paperHref: `/papers/${p.slug}/`,
      paperLabel: p.source_label || p.slug,
      id: c.id,
      title: c.title || "",
      status: c.status || "not_audited",
      attempts: c.attempts ?? 0,
      notes: c.notes || "",
    }))
  )
  .sort((a, b) => (a.paperLabel < b.paperLabel ? -1 : 1));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lemma — Audit Registry</title>
    <meta name="description" content={`${totals.papers} papers audited. ${totals.supported} claims supported. Every failure preserved.`} />
    <link rel="canonical" href="https://lemmabio.netlify.app/papers/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Lemma — Audit Registry" />
    <meta property="og:description" content={`${totals.papers} papers. ${totals.claims} claims. ${totals.supported} reproduced. Every failure preserved.`} />
    <meta property="og:url" content="https://lemmabio.netlify.app/papers/" />
    <meta property="og:image" content="https://lemmabio.netlify.app/og-image.png" />
    <meta name="theme-color" content="#0b1018" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <BgGlass />
    <div class="spectrum-fixed" aria-hidden="true"></div>

    <main class="registry">
      <header class="registry-header">
        <a href="/" class="back-link">← lemma</a>
        <h1>audit registry</h1>
        <p class="registry-sub">
          {totals.papers} papers · {totals.claims} claims extracted · {totals.supported} supported ·
          {totals.inconclusive} inconclusive · {totals.failures_preserved} failures preserved ·
          {totals.logbooks} evidence logbooks published
        </p>
      </header>

      <div class="registry-grid">
        {papers.map((p: any) => (
          <a href={`/papers/${p.slug}/`} class="paper-card">
            <div class="card-top">
              <span class="card-source">{p.source_label}</span>
              <span class={`card-role ${p.role === "fixture" ? "role-fixture" : "role-audit"}`}>
                {p.role}
              </span>
            </div>
            <h2 class="card-title">{p.title}</h2>
            <p class="card-blurb">{p.blurb}</p>
            <div class="card-claims">
              {p.claims.map((c: any) => (
                <StatusBadge status={c.status} />
              ))}
            </div>
            <div class="card-footer">
              {p.judge && (
                <span class="card-judge">
                  {p.judge.verdict} {p.judge.score}
                </span>
              )}
              <span class="card-date">{p.audited_at}</span>
            </div>
          </a>
        ))}
      </div>

      <section class="explorer" id="explorer">
        <div class="explorer-head">
          <h2>every claim, one table</h2>
          <p class="explorer-sub">
            {claimRows.length} claims across {papers.length} papers · filter by verdict, search by title · each row opens the paper's claim dossier
          </p>
        </div>
        <div class="explorer-controls">
          <input type="search" id="claim-search" class="explorer-search" placeholder="search claims…" aria-label="Search claims" />
          <div class="explorer-chips" role="group" aria-label="Filter by verdict">
            <button class="chip active" data-filter="all" type="button">all</button>
            <button class="chip" data-filter="supported" type="button">supported</button>
            <button class="chip" data-filter="falsified" type="button">falsified</button>
            <button class="chip" data-filter="inconclusive" type="button">inconclusive</button>
            <button class="chip" data-filter="not_audited" type="button">not audited</button>
          </div>
        </div>
        <div class="explorer-table" aria-label="All claims across audited papers">
          <div class="explorer-row explorer-th">
            <span>paper</span>
            <span>claim</span>
            <span>verdict</span>
            <span>attempts</span>
            <span>auditor's note</span>
          </div>
          {claimRows.map((r) => (
            <a class="explorer-row" href={r.paperHref} data-status={r.status}>
              <span class="ex-paper">{r.paperLabel}</span>
              <span class="ex-claim"><b>{r.id}</b> {r.title}</span>
              <span class="ex-status"><StatusBadge status={r.status} /></span>
              <span class="ex-attempts">{r.attempts > 0 ? r.attempts : "—"}</span>
              <span class="ex-notes">{r.notes ? r.notes.slice(0, 130) + (r.notes.length > 130 ? "…" : "") : "—"}</span>
            </a>
          ))}
        </div>
        <p class="explorer-empty" id="explorer-empty" hidden>no claims match that filter + search</p>
      </section>
    </main>

    <footer>
      <p>lemma · the trace is the demo</p>
    </footer>
    <ClipMenu />

    <script>
      import "../../paperMotion.ts";
    </script>
    <script is:inline>
      (function () {
        var search = document.getElementById("claim-search");
        var chips = document.querySelectorAll(".chip[data-filter]");
        var rows = document.querySelectorAll(".explorer-row[data-status]");
        var empty = document.getElementById("explorer-empty");
        var currentFilter = "all";
        function apply() {
          var q = (search && search.value || "").toLowerCase();
          var visible = 0;
          rows.forEach(function (row) {
            var st = row.getAttribute("data-status") || "";
            var text = (row.textContent || "").toLowerCase();
            var matchFilter = currentFilter === "all" || st === currentFilter;
            var matchSearch = !q || text.indexOf(q) !== -1;
            var ok = matchFilter && matchSearch;
            row.hidden = !ok;
            if (ok) visible++;
          });
          if (empty) empty.hidden = visible !== 0;
        }
        chips.forEach(function (chip) {
          chip.addEventListener("click", function () {
            currentFilter = chip.getAttribute("data-filter") || "all";
            chips.forEach(function (c) { c.classList.toggle("active", c === chip); });
            apply();
          });
        });
        if (search) search.addEventListener("input", apply);
      })();
    </script>

    <style>
      .registry {
        position: relative;
        z-index: 2;
        max-width: 1100px;
        margin: 0 auto;
        padding: 100px 24px 80px;
      }
      .back-link {
        font-family: var(--font-m);
        font-size: 0.75rem;
        color: var(--dim);
        text-decoration: none;
        letter-spacing: 0.05em;
      }
      .back-link:hover { color: var(--fg); }
      .registry-header {
        margin-bottom: 56px;
      }
      .registry-header h1 {
        font-size: clamp(2.2rem, 5vw, 3.6rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-top: 16px;
        background: linear-gradient(180deg, #ffffff 30%, #aab8d8);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .registry-sub {
        font-family: var(--font-m);
        font-size: 0.78rem;
        color: var(--mut);
        margin-top: 14px;
        line-height: 1.8;
      }
      .registry-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
      }
      .paper-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 28px 24px;
        border: 1px solid var(--edge);
        border-radius: 14px;
        background: color-mix(in srgb, var(--card) 70%, transparent);
        backdrop-filter: blur(12px);
        text-decoration: none;
        transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
      }
      .paper-card:hover {
        border-color: var(--blue);
        transform: translateY(-3px);
        box-shadow: 0 12px 40px -12px rgba(79, 142, 247, 0.15);
      }
      .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .card-source {
        font-family: var(--font-m);
        font-size: 0.68rem;
        color: var(--dim);
        letter-spacing: 0.04em;
      }
      .card-role {
        font-family: var(--font-m);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 2px 8px;
        border-radius: 4px;
      }
      .role-fixture {
        color: var(--violet);
        border: 1px solid color-mix(in srgb, var(--violet) 50%, transparent);
      }
      .role-audit {
        color: var(--teal);
        border: 1px solid color-mix(in srgb, var(--teal) 50%, transparent);
      }
      .card-title {
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.35;
        color: var(--fg);
      }
      .card-blurb {
        font-size: 0.84rem;
        color: var(--mut);
        line-height: 1.6;
        flex: 1;
      }
      .card-claims {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 8px;
        border-top: 1px solid var(--edge);
      }
      .card-judge {
        font-family: var(--font-m);
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--teal);
      }
      .card-date {
        font-family: var(--font-m);
        font-size: 0.68rem;
        color: var(--dim);
      }
    .explorer {
        margin-top: 72px;
        padding-top: 48px;
        border-top: 1px solid var(--edge);
      }
      .explorer-head h2 {
        font-size: clamp(1.6rem, 3.4vw, 2.4rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        color: var(--fg);
      }
      .explorer-sub {
        font-family: var(--font-m);
        font-size: 0.74rem;
        color: var(--mut);
        margin-top: 10px;
        line-height: 1.7;
      }
      .explorer-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        margin: 22px 0 18px;
      }
      .explorer-search {
        flex: 1 1 220px;
        max-width: 320px;
        padding: 9px 14px;
        border: 1px solid var(--edge);
        border-radius: 10px;
        background: color-mix(in srgb, var(--card) 70%, transparent);
        color: var(--fg);
        font-family: var(--font-m);
        font-size: 0.78rem;
      }
      .explorer-search:focus {
        outline: none;
        border-color: var(--blue);
      }
      .explorer-search::placeholder {
        color: var(--dim);
      }
      .explorer-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .chip {
        font-family: var(--font-m);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 6px 12px;
        border: 1px solid var(--edge);
        border-radius: 99px;
        background: transparent;
        color: var(--mut);
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .chip:hover {
        border-color: var(--blue);
        color: var(--fg);
      }
      .chip.active {
        border-color: var(--teal);
        background: color-mix(in srgb, var(--teal) 14%, transparent);
        color: var(--teal);
      }
      .explorer-table {
        border: 1px solid var(--edge);
        border-radius: 12px;
        overflow: hidden;
      }
      .explorer-row {
        display: grid;
        grid-template-columns: 120px 1.6fr 110px 70px 1.8fr;
        gap: 14px;
        align-items: center;
        padding: 11px 16px;
        border-bottom: 1px solid var(--edge);
        background: color-mix(in srgb, var(--card) 40%, transparent);
        font-size: 0.82rem;
        color: var(--mut);
        text-decoration: none;
        transition: background 0.15s, border-color 0.15s;
      }
      .explorer-row:last-child {
        border-bottom: none;
      }
      .explorer-row[data-status]:hover {
        background: color-mix(in srgb, var(--blue) 10%, transparent);
      }
      .explorer-th {
        grid-template-columns: 120px 1.6fr 110px 70px 1.8fr;
        font-family: var(--font-m);
        font-size: 0.64rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--dim);
        background: color-mix(in srgb, var(--bg2) 80%, transparent);
      }
      .ex-paper {
        font-family: var(--font-m);
        font-size: 0.7rem;
        color: var(--blue);
      }
      .ex-claim b {
        color: var(--teal);
        font-family: var(--font-m);
        margin-right: 6px;
      }
      .ex-attempts {
        font-family: var(--font-m);
        font-size: 0.74rem;
      }
      .ex-notes {
        font-size: 0.76rem;
        line-height: 1.5;
        color: var(--dim);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .explorer-empty {
        margin-top: 16px;
        font-family: var(--font-m);
        font-size: 0.76rem;
        color: var(--dim);
      }

      @media (max-width: 720px) {
        .explorer-row,
        .explorer-th {
          grid-template-columns: 90px 1fr 70px;
        }
        .ex-notes,
        .explorer-table > .explorer-th > span:nth-child(5) {
          display: none;
        }
        .ex-attempts {
          grid-column: 3;
        }
      }

    </style>
  </body>
</html>
