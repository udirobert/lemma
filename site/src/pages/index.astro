---
import "@fontsource-variable/montserrat";
import "@fontsource-variable/roboto-mono";
import "../styles/global.css";
import Xylophone from "../components/Xylophone.astro";
import TracePlayer from "../components/TracePlayer.astro";
import BgGlass from "../components/BgGlass.astro";
import papersData from "../data/papers.json";

const papers = papersData.papers as Array<{
  slug: string;
  title: string;
  source_label: string;
  source_url: string | null;
  blurb: string;
  role: string;
  audited_at: string;
  summary: { supported: number; falsified: number; inconclusive: number; not_audited: number };
  judge: { verdict: string; score: string } | null;
  links: { logbook: string | null; dataset: string | null; paper: string | null };
  trace: { n_events: number; wall_min: number };
}>;
const totals = papersData.totals as {
  papers: number;
  claims: number;
  supported: number;
  inconclusive: number;
  audited: number;
  failures_preserved: number;
  logbooks: number;
};

// Artifact links generated from the paper registry — no manual editing needed
// when a new paper lands (meta.json → _index.json → papers.json).
const ARTIFACTS = [
  {
    group: "audited papers",
    items: papers.map((p) => ({
      k: `${p.source_label || p.slug}`,
      d: `${p.summary.supported} supported / ${p.summary.inconclusive} inconclusive · judge ${p.judge ? `${p.judge.verdict} ${p.judge.score}` : "pending"}`,
      u: `/papers/${p.slug}`,
      internal: true,
    })),
  },
  {
    group: "evidence logbooks",
    items: papers
      .filter((p) => p.links.logbook)
      .map((p) => ({
        k: `logbook · ${p.slug}`,
        d: "Trackio logbook — the inspectable evidence trail",
        u: p.links.logbook as string,
      })),
  },
  {
    group: "raw evidence",
    items: papers
      .filter((p) => p.links.dataset)
      .map((p) => ({
        k: `dataset · ${p.slug}`,
        d: "every run output + failed attempt included",
        u: p.links.dataset as string,
      })),
  },
  {
    group: "code",
    items: [
      {
        k: "repository",
        d: "pipeline, traces, feedback, reviewer references",
        u: "https://github.com/udirobert/lemma",
      },
    ],
  },
];

const TRACE: Array<{ tag: string; cls: string; text: string }> = [
  { tag: "note", cls: "info", text: "lemma v0.1 · ICML 2026 agent reproductions challenge — judge PASS, end to end" },
  { tag: "note", cls: "warn", text: "repo dormant… 3 weeks, 0 commits, 1 grokking paper on disk" },
  { tag: "run", cls: "cmd", text: "lemma audit jmlr-22-1228 --stages extract,audit,evidence,judge" },
  { tag: "extract", cls: "ok", text: "6 claims → C1…C6 · success criteria taken from the claims themselves" },
  { tag: "audit", cls: "fail", text: "round 1 · Qwen3.8-27B · 0 supported / 0 falsified / 6 inconclusive" },
  { tag: "audit", cls: "fail", text: "bake-off gate · ν ≈ 6000 vs expected 1.0 — capability boundary detected, not papered over" },
  { tag: "run", cls: "cmd", text: "lemma audit --endpoint kimi:k3 · bake-off first" },
  { tag: "audit", cls: "ok", text: "bake-off gate · ν = 0.9911 — PASS · model swap authorized" },
  { tag: "audit", cls: "ok", text: "round 3 · C1 supported · ν = 0.9983 vs 1.0 · closed-form cross-check OK" },
  { tag: "audit", cls: "ok", text: "rounds 4–5 · C3, C4, C5, C6 supported via reviewer-reference escalation" },
  { tag: "judge", cls: "ok", text: "evidence trail PASS 5/5 · 353 trace events · all failures preserved" },
  { tag: "run", cls: "cmd", text: "lemma audit arxiv-2510.10981" },
  { tag: "judge", cls: "ok", text: "evidence trail PASS 5/5 · 267 events · 3 supported, 3 honestly inconclusive" },
  { tag: "note", cls: "info", text: "inconclusive is a result — a patched false-positive is not" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lemma — the AI scientist that distrusts itself</title>
    <meta
      name="description"
      content={`Lemma audits papers claim by claim, keeps every failed attempt, and scores its own evidence trail. ${totals.papers} papers, ${totals.claims} claims, ${totals.supported} reproduced — everything public.`}
    />
    <link rel="canonical" href="https://lemmabio.netlify.app/" />

    <!-- icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- open graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lemma" />
    <meta property="og:title" content="Lemma — the AI scientist that distrusts itself" />
    <meta
      property="og:description"
      content="An audit agent that reproduces scientific claims, catches its own capability wall, and publishes every failure. Play the claim xylophone."
    />
    <meta property="og:url" content="https://lemmabio.netlify.app/" />
    <meta property="og:image" content="https://lemmabio.netlify.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lemma — spectrum glass bars over deep navy with the audit scoreboard" />

    <!-- twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Lemma — the AI scientist that distrusts itself" />
    <meta
      name="twitter:description"
      content={`${totals.papers} papers · ${totals.claims} claims · ${totals.supported} reproduced · every failure public. Play the claim xylophone.`}
    />
    <meta name="twitter:image" content="https://lemmabio.netlify.app/og-image.png" />

    <meta name="theme-color" content="#0b1018" />
    <script
      defer
      data-domain="lemmabio.netlify.app"
      src="https://plausible.io/js/script.tagged-events.outbound-links.js"
    ></script>
  </head>
  <body>
    <BgGlass />
    <div class="spectrum-fixed" aria-hidden="true"></div>

<!-- ================= HERO ================= -->
<header class="hero" id="top">
  <div class="hero-copy">
    <p class="kicker">evidence over assertion</p>
    <h1>Lemma</h1>
    <p class="tagline">the AI scientist that <em>distrusts itself</em></p>
    <p class="hero-sub">
      Every claim gets a verdict. Every failure is preserved. Nothing is
      patched into a pass. This is its instrument: <strong>{totals.audited} bars, one per
      audited claim across {totals.papers} papers.</strong> Bright bars reproduced. Dim bars are honest
      inconclusives. Play it.
    </p>
  </div>
  <div class="xylo-scene">
    <Xylophone />
  </div>
  <p class="scroll-cue" aria-hidden="true">scroll ↓</p>
</header>

<!-- ================= STORY ================= -->
<section class="story" id="story">
  <div class="wrap">
    <article class="beat c-blue">
      <span class="beat-n">01</span>
      <div>
        <h3>the first life</h3>
        <p>
          Lemma was born for the ICML 2026 Agent Reproductions challenge:
          one grokking paper, audited end to end, <strong>judge PASS</strong>.
          Then it slept — a dormant repo with one good result on disk.
        </p>
      </div>
    </article>

    <article class="beat c-magenta">
      <span class="beat-n">02</span>
      <div>
        <h3>the night it failed</h3>
        <p>
          Reawakened on a JMLR paper about cellular automata, its first models
          returned every claim inconclusive. Not wrong — just not smart enough.
          We gave them a physics test anyway. Expected critical exponent 1.0:
        </p>
        <div class="big-stat">ν ≈ <span data-count="6000">0</span></div>
      </div>
    </article>

    <article class="beat c-teal">
      <span class="beat-n">03</span>
      <div>
        <h3>the turn</h3>
        <p>
          Most agents would have written a confident paragraph and moved on.
          Lemma's validator auto-rejects any verdict that contradicts its own
          metrics — so the fix was gated: no model swap until the replacement
          passed the same physics test. It scored
          <strong>0.99</strong>. Next round: <strong>0.9983</strong>. The
          claims started falling.
        </p>
        <div class="big-stat"><span data-count="0.9983" data-decimals="4">0</span></div>
      </div>
    </article>

    <article class="beat c-gold">
      <span class="beat-n">04</span>
      <div>
        <h3>the receipts</h3>
        <p>
          {totals.papers} papers, {totals.claims} claims, and a trail you can reconstruct line by
          line — including everything that failed.
        </p>
        <div class="receipts">
          <div class="receipt"><b><span data-count={totals.papers}>0</span></b><span>papers</span></div>
          <div class="receipt"><b><span data-count={totals.claims}>0</span></b><span>claims</span></div>
          <div class="receipt"><b><span data-count={totals.supported}>0</span></b><span>reproduced</span></div>
          <div class="receipt"><b><span data-count={totals.failures_preserved}>0</span></b><span>failures preserved</span></div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- ================= TRACE ================= -->
<section class="trace" id="trace">
  <div class="wrap trace-pin">
    <div class="trace-head">
      <h2>The trail is the product</h2>
      <p>
        Every LLM call, every script, every rejection lands in an append-only
        trace. Scroll — the audit writes itself.
      </p>
    </div>
    <div class="terminal" aria-label="Audit trace excerpt">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">trace.jsonl — append-only</span>
      </div>
      <div class="term-body">
        {TRACE.map((l) => (
          <span class="tl">
            <span class="tag">[{l.tag}]</span> <span class={l.cls}>{l.text}</span>
          </span>
        ))}
        <span class="caret" aria-hidden="true"></span>
      </div>
    </div>
    <p class="trace-note">extract → audit → evidence → judge · verdict validator · positive controls · reviewer-reference escalation</p>
  </div>
</section>

<!-- ================= REPLAY ================= -->
<section class="replay" id="replay">
  <div class="wrap">
    <div class="trace-head">
      <h2>Replay an audit, line by line</h2>
      <p>
        The real append-only traces from {totals.papers} completed runs — every model call,
        every script, every rejection and verdict flip. Scrub it, play it,
        watch a claim go from falsified to supported across rounds.
      </p>
    </div>
    <TracePlayer />
    <p class="replay-cta">
      Want this on <em>your</em> paper?
      <a href="#waitlist" class="cta-inline" data-cta="request-audit">request an audit ↓</a>
    </p>
  </div>
</section>

<!-- ================= WAITLIST ================= -->
<section class="waitlist" id="waitlist">
  <div class="wrap">
    <div class="trace-head">
      <h2>Run it on your paper</h2>
      <p>
        An interactive version is in the works: paste an arXiv id, watch the
        claims come out. Leave your email and we'll let you in when the gate
        opens — or tell us which paper you'd audit first.
      </p>
    </div>
    <form
      name="lemma-interest"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="wl-form"
    >
      <input type="hidden" name="form-name" value="lemma-interest" />
      <p class="wl-hidden" aria-hidden="true">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>
      <label class="wl-field">
        <span>email</span>
        <input type="email" name="email" required placeholder="you@lab.org" />
      </label>
      <label class="wl-field">
        <span>i'm here to</span>
        <select name="interest" required>
          <option value="waitlist">join the waitlist</option>
          <option value="request-audit">request an audit of my paper</option>
          <option value="partner">partner / fund a pilot</option>
          <option value="other">collaborate / other</option>
        </select>
      </label>
      <label class="wl-field wl-wide">
        <span>which paper, and why <i>(optional)</i></span>
        <input type="text" name="paper" placeholder="arXiv id + what you'd want checked" />
      </label>
      <button type="submit" class="wl-btn" data-cta="waitlist-submit">get early access</button>
    </form>
    <div class="wl-alt">
      <a href="https://github.com/udirobert/lemma" target="_blank" rel="noopener" class="star-link">
        ★ <span id="gh-stars">—</span> on GitHub
      </a>
      <span class="wl-note">no backend of our own yet — stars and signups are the queue</span>
    </div>
  </div>
</section>

<!-- ================= ARTIFACTS ================= -->
<section class="artifacts" id="artifacts">
  <div class="wrap">
    <h2>Everything is public</h2>
    {ARTIFACTS.map((g) => (
      <div class="artifact-group">
        <span class="artifact-label">{g.group}</span>
        {g.items.map((a: { k: string; d: string; u: string; internal?: boolean }) => (
          <a class="link-row" href={a.u} target={a.internal ? undefined : "_blank"} rel={a.internal ? undefined : "noopener"}>
            <span class="k">{a.k}</span>
            <span>{a.d}</span>
          </a>
        ))}
      </div>
    ))}
    <div class="artifact-group">
      <a class="link-row papers-index-link" href="/papers/">
        <span class="k">all papers →</span>
        <span>the full audit registry: claims, verdicts, figures, traces</span>
      </a>
    </div>
  </div>
</section>

<footer>
  <p>lemma · the trace is the demo</p>
</footer>

<!-- ================= CLIP MENU ================= -->
<button class="menu-btn" aria-label="Open navigation" aria-expanded="false">
  <span class="bars-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</button>
<nav class="menu-panel" aria-label="Site navigation">
  <ul>
    <li><span class="menu-sub">lemma</span></li>
    <li><a href="#story"><span class="idx">01</span>story</a></li>
    <li><a href="#trace"><span class="idx">02</span>trace</a></li>
    <li><a href="#replay"><span class="idx">03</span>replay</a></li>
    <li><a href="#waitlist"><span class="idx">04</span>waitlist</a></li>
    <li><a href="#artifacts"><span class="idx">05</span>artifacts</a></li>
    <li><a href="/papers/"><span class="idx">06</span>papers</a></li>
    <li><a href="https://github.com/udirobert/lemma" target="_blank" rel="noopener"><span class="idx">→</span>github</a></li>
  </ul>
</nav>

<script src="../motion.ts"></script>
<script src="../player.ts"></script>
<script src="../signals.ts"></script>
  </body>
</html>
