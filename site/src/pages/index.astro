---
import "@fontsource-variable/montserrat";
import "@fontsource-variable/roboto-mono";
import "../styles/global.css";
import Xylophone from "../components/Xylophone.astro";
import TracePlayer from "../components/TracePlayer.astro";
import BgGlass from "../components/BgGlass.astro";
import ClipMenu from "../components/ClipMenu.astro";
import Landscape from "../components/Landscape.astro";
import SpecimenField from "../components/SpecimenField.astro";
import PipelineExplorer from "../components/PipelineExplorer.astro";
import papersData from "../data/papers.json";

const papers = papersData.papers as Array<{
  slug: string;
  title: string;
  source_label: string;
  source_url: string | null;
  blurb: string;
  role: string;
  audited_at: string;
  summary: { supported: number; falsified: number; inconclusive: number; not_audited: number };
  judge: { verdict: string; score: string } | null;
  links: { logbook: string | null; dataset: string | null; paper: string | null };
  trace: { n_events: number; wall_min: number };
}>;
const totals = papersData.totals as {
  papers: number;
  claims: number;
  supported: number;
  inconclusive: number;
  audited: number;
  failures_preserved: number;
  logbooks: number;
  llm_calls: number;
  tool_runs: number;
  wall_min: number;
  attempts: number;
};

// The open ledger — one row per paper carrying its verdict strip, judge
// badge, and artifact links. The flagship corpus cluster leads; the
// regression fixture trails. Generated from the registry — no manual edits
// when a new paper lands (meta.json → _index.json → papers.json).
const ROLE_ORDER: Record<string, number> = { audit: 1, corpus: 0, fixture: 2 };
const LEDGER = [...papers].sort((a, b) => {
  const fa = a.slug === "double-descent" ? -1 : 0;
  const fb = b.slug === "double-descent" ? -1 : 0;
  return fa - fb || (ROLE_ORDER[a.role] ?? 1) - (ROLE_ORDER[b.role] ?? 1);
});
const strip = (s: { supported: number; falsified: number; inconclusive: number; not_audited: number }) =>
  [
    ...Array(s.supported).fill("sup"),
    ...Array(s.falsified).fill("fal"),
    ...Array(s.inconclusive).fill("inc"),
    ...Array(s.not_audited).fill("na"),
  ];

const TRACE: Array<{ tag: string; cls: string; text: string }> = [
  { tag: "director", cls: "cmd", text: "triage · arxiv 1912.07242 — sample-wise double descent" },
  { tag: "extract", cls: "ok", text: "6 claims → C1…C6 · success criteria taken from the claims themselves" },
  { tag: "audit", cls: "fail", text: "C2 · timeout ×3, crash ×1 — every failed attempt kept on the record" },
  { tag: "audit", cls: "warn", text: "C2 · falsified — positive control passed, so the verdict is trusted" },
  { tag: "human", cls: "cmd", text: "feedback.md · the claims are dimension-agnostic — bound d ≤ 300" },
  { tag: "audit", cls: "ok", text: "re-audit · C1 + C2 supported in 4.5 min — 14× faster than round one" },
  { tag: "propose", cls: "ok", text: "proposer agent · the risk valley at γ* = 0.90 — promoted to claim C7" },
  { tag: "audit", cls: "ok", text: "C7 · agent-generated · supported in 14 s · control green" },
  { tag: "audit", cls: "warn", text: "C8 · independent E[β̂] = γβ check falsified at γ = 0.1 — invisible to the circular test" },
  { tag: "audit", cls: "fail", text: "C9 · error at the noise floor, control failed → inconclusive, recorded as such" },
  { tag: "corpus", cls: "cmd", text: "sweep · hastie et al. 1903.08560 · bartlett et al. 1906.11300" },
  { tag: "audit", cls: "warn", text: "bartlett C1 + C6 · falsified — published claims failing controlled tests" },
  { tag: "map", cls: "ok", text: "verification map · 21 claims · 3 papers · 7 supported / 4 falsified / 3 inconclusive" },
  { tag: "judge", cls: "ok", text: "evidence trail PASS 5/5 · every failure preserved" },
  { tag: "note", cls: "info", text: "inconclusive is a result — a patched false-positive is not" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lemma — the AI scientist that distrusts itself</title>
    <meta
      name="description"
      content={`Lemma audits papers claim by claim, keeps every failed attempt, and scores its own evidence trail. ${totals.papers} papers, ${totals.claims} claims, ${totals.supported} reproduced — everything public.`}
    />
    <link rel="canonical" href="https://lemmabio.netlify.app/" />

    <!-- icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- open graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lemma" />
    <meta property="og:title" content="Lemma — the AI scientist that distrusts itself" />
    <meta
      property="og:description"
      content="An audit agent that reproduces scientific claims, catches its own capability wall, and publishes every failure. Play the claim xylophone."
    />
    <meta property="og:url" content="https://lemmabio.netlify.app/" />
    <meta property="og:image" content="https://lemmabio.netlify.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lemma — spectrum glass bars over deep navy with the audit scoreboard" />

    <!-- twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Lemma — the AI scientist that distrusts itself" />
    <meta
      name="twitter:description"
      content={`${totals.papers} papers · ${totals.claims} claims · ${totals.supported} reproduced · every failure public. Play the claim xylophone.`}
    />
    <meta name="twitter:image" content="https://lemmabio.netlify.app/og-image.png" />

    <meta name="theme-color" content="#0b1018" />
    <script
      defer
      data-domain="lemmabio.netlify.app"
      src="https://plausible.io/js/script.tagged-events.outbound-links.js"
    ></script>
  </head>
  <body>
    <BgGlass />
    <SpecimenField />
    <div class="spectrum-fixed" aria-hidden="true"></div>

<!-- ================= HERO ================= -->
<header class="hero" id="top" data-specimen="cloud">
  <div class="hero-copy">
    <p class="kicker">evidence over assertion</p>
    <h1>Lemma</h1>
    <p class="tagline">the AI scientist that <em>distrusts itself</em></p>
    <p class="hero-sub">
      Machines are beginning to do science faster than anyone can check it.
      Lemma is the missing layer — a lab that turns claims into inspectable
      verdicts, keeps every failure, and distrusts itself first.
    </p>
    <div class="hero-ctas">
      <a class="hero-cta" href="/room/?paper=icl-bayesian&claim=C6" data-cta="enter-audit-room">Enter the Audit Room</a>
      <a class="hero-cta secondary" href="#waitlist" data-cta="audit-new-paper">Audit a new paper</a>
    </div>
    <p class="hero-note">Recorded evidence · failures included</p>
  </div>
  <div class="xylo-scene">
    <Xylophone />
  </div>
  <p class="scroll-cue" aria-hidden="true">scroll ↓</p>
</header>

<!-- ================= STORY ================= -->
<section class="story" id="story">
  <div class="wrap">
    <article class="beat c-blue" data-specimen="helix">
      <span class="beat-n">01</span>
      <div>
        <h3>the mission</h3>
        <p>
          Science is about to be written at machine speed — and nobody can
          verify that fast. Lemma's job is the missing layer: make checking a
          claim as cheap as making one, so every result in the literature can
          carry a verdict you can inspect, with the evidence attached.
        </p>
      </div>
    </article>

    <article class="beat c-magenta" data-specimen="petri">
      <span class="beat-n">02</span>
      <div>
        <h3>the approach</h3>
        <p>
          Not a reviewer — an instrument. The lab extracts testable claims,
          writes and runs its own controlled numerical experiments, and
          snapshots every attempt immutably. A failed control reads
          <strong>inconclusive, never falsified</strong> — and an independent
          judge scores the trail itself.
        </p>
      </div>
    </article>

    <article class="beat c-teal" data-specimen="curve">
      <span class="beat-n">03</span>
      <div>
        <h3>what it found</h3>
        <p>
          Pointed at the high-dimensional regression literature, the lab
          audited <strong>21 claims across three papers</strong> — and two
          published claims failed their own controlled tests. Between them,
          new science: an agent-generated hypothesis verified in seconds, and
          a measurement no paper reported — the asymptotic risk approximation
          is already within ~0.1% at d&nbsp;=&nbsp;80.
        </p>
        <div class="big-stat"><span data-count="21">0</span> claims · <span data-count="3">0</span> papers</div>
      </div>
    </article>

    <article class="beat c-gold" data-specimen="grid">
      <span class="beat-n">04</span>
      <div>
        <h3>the receipts</h3>
        <p>
          {totals.papers} papers, {totals.claims} claims, and a trail you can reconstruct line by
          line — including everything that failed.
        </p>
        <div class="receipts">
          <div class="receipt"><b><span data-count={totals.papers}>0</span></b><span>papers</span></div>
          <div class="receipt"><b><span data-count={totals.claims}>0</span></b><span>claims</span></div>
          <div class="receipt"><b><span data-count={totals.supported}>0</span></b><span>reproduced</span></div>
          <div class="receipt"><b><span data-count={totals.failures_preserved}>0</span></b><span>failures preserved</span></div>
          <div class="receipt"><b><span data-count={totals.wall_min} data-decimals="0">0</span></b><span>wall minutes</span></div>
          <div class="receipt"><b><span data-count={totals.llm_calls}>0</span></b><span>model calls</span></div>
          <div class="receipt"><b><span data-count={totals.tool_runs}>0</span></b><span>tool runs</span></div>
          <div class="receipt"><b><span data-count={totals.attempts}>0</span></b><span>audit attempts</span></div>
        </div>
        <p class="receipts-note">the cost of honesty — every number was spent to find out, not to prove.</p>
      </div>
    </article>

    <article class="beat c-blue" data-specimen="network">
      <span class="beat-n">05</span>
      <div>
        <h3>the vision</h3>
        <p>
          One literature is a start — not the destination. The goal is a
          verification map of science itself: every claim tracking its
          evidence, every failure preserved, every uncertainty stated in the
          open. Discovery accelerates the moment trust becomes cheap. That is
          the lab we are building.
        </p>
      </div>
    </article>
  </div>
</section>

<!-- ================= LANDSCAPE ================= -->
<Landscape />

<!-- ================= PIPELINE ================= -->
<PipelineExplorer />

<!-- ================= TRACE ================= -->
<section class="trace" id="trace" data-specimen="wave">
  <div class="wrap trace-pin">
    <div class="trace-head">
      <h2>The trail is the product</h2>
      <p>
        Every LLM call, every script, every rejection lands in an append-only
        trace. Scroll — the audit writes itself.
      </p>
    </div>
    <div class="terminal" aria-label="Audit trace excerpt">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">trace.jsonl — append-only</span>
      </div>
      <div class="term-body">
        {TRACE.map((l) => (
          <span class="tl">
            <span class="tag">[{l.tag}]</span> <span class={l.cls}>{l.text}</span>
          </span>
        ))}
        <span class="caret" aria-hidden="true"></span>
      </div>
    </div>
    <p class="trace-note">extract → audit → evidence → judge · verdict validator · positive controls · reviewer-reference escalation</p>
  </div>
</section>

<!-- ================= REPLAY ================= -->
<section class="replay" id="replay" data-specimen="curve">
  <div class="wrap">
    <div class="trace-head">
      <h2>Replay an audit, line by line</h2>
      <p>
        The real append-only traces from {totals.papers} completed runs — every model call,
        every script, every rejection and verdict flip. Scrub it, play it,
        watch a claim go from falsified to supported across rounds.
      </p>
    </div>
    <TracePlayer />
    <p class="replay-cta">
      Want this on <em>your</em> paper?
      <a href="#waitlist" class="cta-inline" data-cta="request-audit">request an audit ↓</a>
    </p>
  </div>
</section>

<!-- ================= WAITLIST ================= -->
<section class="waitlist" id="waitlist" data-specimen="colony">
  <div class="wrap">
    <div class="trace-head">
      <h2>Audit a new paper</h2>
      <p>
        New-paper audits run on the local CLI — this form is a request line,
        not a hosted run. The recorded evidence is already live:
        <a href="/room/?paper=icl-bayesian&claim=C6" class="cta-inline" data-cta="waitlist-enter-room">enter the Audit Room</a>,
        or run it yourself:
      </p>
      <p><code class="cli-cmd">./lemma audit &lt;arxiv-id&gt; --jobs 2</code></p>
      <p>
        Leave your email to request an audit or get notified when a hosted
        version opens — tell us which paper you'd check first.
      </p>
    </div>
    <form
      name="lemma-interest"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="wl-form"
    >
      <input type="hidden" name="form-name" value="lemma-interest" />
      <p class="wl-hidden" aria-hidden="true">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>
      <label class="wl-field">
        <span>email</span>
        <input type="email" name="email" required placeholder="you@lab.org" />
      </label>
      <label class="wl-field">
        <span>i'm here to</span>
        <select name="interest" required>
          <option value="waitlist">join the waitlist</option>
          <option value="request-audit">request an audit of my paper</option>
          <option value="partner">partner / fund a pilot</option>
          <option value="other">collaborate / other</option>
        </select>
      </label>
      <label class="wl-field wl-wide">
        <span>which paper, and why <i>(optional)</i></span>
        <input type="text" name="paper" id="paper-input" placeholder="arXiv id + what you'd want checked" />
      </label>
      <div class="wl-preview" id="claim-preview" hidden>
        <div class="wl-preview-bar">
          <span class="wl-preview-label">extract</span>
          <span class="wl-preview-status" id="preview-status">awaiting arxiv id…</span>
        </div>
        <div class="wl-preview-list" id="preview-claims"></div>
      </div>
      <button type="submit" class="wl-btn" data-cta="waitlist-submit">get early access</button>
    </form>
    <div class="wl-alt">
      <a href="https://github.com/udirobert/lemma" target="_blank" rel="noopener" class="star-link">
        ★ <span id="gh-stars">—</span> on GitHub
      </a>
      <span class="wl-note">no backend of our own yet — stars and signups are the queue</span>
    </div>
  </div>
</section>

<!-- ================= LEDGER ================= -->
<section class="artifacts" id="artifacts" data-specimen="grid">
  <div class="wrap">
    <div class="ledger-head">
      <h2>Everything is public</h2>
      <p class="ledger-sub">the verification ledger — every paper, every claim, every failure on record</p>
    </div>
    <div class="ledger-actions">
      <a class="link-row" href="/demo/">
        <span class="k">discovery replay →</span>
        <span>question → verdict, agent handoffs, one human gate — the loop in 110 s</span>
      </a>
      <a class="link-row" href="/papers/">
        <span class="k">the full registry →</span>
        <span>claims, verdicts, figures, traces — per paper</span>
      </a>
      <a class="link-row" href="https://github.com/udirobert/lemma" target="_blank" rel="noopener">
        <span class="k">repository ↗</span>
        <span>pipeline, traces, feedback, reviewer references</span>
      </a>
    </div>
    <div class="ledger">
      {LEDGER.map((p) => (
        <div class="ledger-row">
          <div class="ledger-main">
            <a class="ledger-title" href={`/papers/${p.slug}`}>{p.title}</a>
            {p.links.paper && (
              <a class="ledger-src" href={p.links.paper} target="_blank" rel="noopener">{p.source_label} ↗</a>
            )}
          </div>
          <div class="ledger-verdicts">
            <span class="claim-strip" aria-hidden="true">
              {strip(p.summary).map((s) => <i class={`cs-${s}`} />)}
            </span>
            <span class="ledger-counts">
              {p.summary.supported > 0 && `${p.summary.supported} supported`}
              {p.summary.falsified > 0 && ` · ${p.summary.falsified} falsified`}
              {p.summary.inconclusive > 0 && ` · ${p.summary.inconclusive} inconclusive`}
              {p.summary.not_audited > 0 && ` · ${p.summary.not_audited} untested`}
            </span>
          </div>
          <div class="ledger-artifacts">
            {p.judge
              ? <span class={`judge-badge ${p.judge.verdict === "PASS" ? "pass" : "warn"}`}>judge {p.judge.verdict} {p.judge.score}</span>
              : <span class="judge-badge dim">judge pending</span>}
            {p.links.logbook && <a href={p.links.logbook} target="_blank" rel="noopener">logbook ↗</a>}
            {p.links.dataset && <a href={p.links.dataset} target="_blank" rel="noopener">dataset ↗</a>}
          </div>
        </div>
      ))}
    </div>
    <p class="ledger-legend">
      <i class="cs-sup" /> supported
      <i class="cs-fal" /> falsified
      <i class="cs-inc" /> inconclusive
      <i class="cs-na" /> not yet tested
      <span class="ledger-legend-note">— inconclusive is a result, not a failure to report one</span>
    </p>
  </div>
</section>

<footer data-specimen="cloud">
  <p>lemma · the trace is the demo</p>
</footer>

<script src="../motion.ts"></script>
<script src="../player.ts"></script>
<script src="../signals.ts"></script>
<ClipMenu />
  </body>
</html>
