---
import "../styles/global.css";
import BgGlass from "../components/BgGlass.astro";
import ClipMenu from "../components/ClipMenu.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Discovery replay — Lemma lab</title>
    <meta name="description" content="One paper, six claims, three agents, one human — the full discovery loop replayed." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b1018" />
  </head>
  <body class="demo-body">
    <BgGlass />
    <div class="spectrum-fixed" aria-hidden="true"></div>

    <!-- intro overlay -->
    <div class="d-intro" id="d-intro">
      <div class="d-intro-inner">
        <div class="d-kicker">lemma lab · discovery replay · every frame real</div>
        <h1 class="d-title">
          one paper.<br />six claims.<br />three agents.<br /><em>one human.</em>
        </h1>
        <p class="d-sub">
          More Data Can Hurt for Linear Regression — the sample-wise double-descent
          paper — through the full loop: evidence → falsification → human feedback →
          a hypothesis the agents generated themselves → a verdict.
        </p>
        <button class="d-play" id="d-play" aria-label="Play the discovery replay">
          <span class="d-play-tri">▶</span> run the replay
        </button>
        <div class="d-intro-meta">arXiv 1912.07242 · ~2h13m wall time · 110 s replay</div>
      </div>
    </div>

    <!-- mission control -->
    <main class="d-console" id="d-console" hidden>
      <header class="d-head">
        <div class="d-brand">LEMMA<span>·lab</span></div>
        <div class="d-head-paper">
          <span class="d-head-tag">DISCOVERY REPLAY</span>
          <span class="d-head-title">arXiv 1912.07242 — sample-wise double descent</span>
        </div>
        <div class="d-head-right">
          <span class="d-judge-chip" id="d-judge-chip" hidden>judge <b>PASS 5/5</b></span>
          <a class="d-head-link" href="/papers/double-descent/">full audit ↗</a>
        </div>
      </header>

      <div class="d-grid">
        <!-- agents -->
        <aside class="d-rail d-agents" id="d-agents" aria-label="Agent roster"></aside>

        <!-- stage + ledger -->
        <section class="d-center">
          <div class="d-stage" id="d-stage" aria-live="polite"></div>
          <div class="d-ledger" id="d-ledger"></div>
        </section>

        <!-- loop + counters -->
        <aside class="d-rail d-right">
          <div class="d-loop" id="d-loop" aria-label="Discovery loop phases"></div>
          <div class="d-counters">
            <div class="d-counter"><span class="d-counter-k" id="c-wall">00:00</span><span class="d-counter-v">wall clock</span></div>
            <div class="d-counter"><span class="d-counter-k" id="c-attempts">0</span><span class="d-counter-v">attempts</span></div>
            <div class="d-counter"><span class="d-counter-k" id="c-failed">0</span><span class="d-counter-v">failures kept</span></div>
            <div class="d-counter"><span class="d-counter-k" id="c-verdicts">0</span><span class="d-counter-v">verdicts</span></div>
          </div>
        </aside>
      </div>

      <!-- timeline -->
      <footer class="d-tl">
        <button class="d-pp" id="d-pp" aria-label="Play or pause">❚❚</button>
        <div class="d-track" id="d-track">
          <div class="d-track-fill" id="d-track-fill"></div>
          <div class="d-ticks" id="d-ticks"></div>
        </div>
        <div class="d-chapter" id="d-chapter">—</div>
        <div class="d-clock" id="d-clock">0:00 / 1:45</div>
      </footer>
    </main>

    <style>
      .demo-body { overflow: hidden; height: 100vh; }
      .d-console[hidden] { display: none; }

      /* ---------------- intro ---------------- */
      .d-intro {
        position: fixed; inset: 0; z-index: 40;
        display: flex; align-items: center; justify-content: center;
        background:
          radial-gradient(ellipse 60% 50% at 30% 20%, rgba(79,142,247,.14), transparent 65%),
          radial-gradient(ellipse 50% 45% at 75% 70%, rgba(212,69,242,.10), transparent 65%),
          var(--bg);
        transition: opacity .5s ease;
      }
      .d-intro.out { opacity: 0; pointer-events: none; }
      .d-intro-inner { max-width: 720px; padding: 24px; text-align: left; }
      .d-kicker {
        font-family: var(--font-m); font-size: .7rem; letter-spacing: .22em;
        text-transform: uppercase; color: var(--teal); margin-bottom: 26px;
      }
      .d-title {
        font-size: clamp(2.6rem, 7vw, 5rem); font-weight: 800;
        line-height: 1.02; letter-spacing: -0.02em; margin-bottom: 26px;
      }
      .d-title em { font-style: normal; color: var(--gold); }
      .d-sub { color: var(--mut); font-size: 1.05rem; max-width: 56ch; margin-bottom: 36px; }
      .d-play {
        appearance: none; border: 1px solid var(--teal); border-radius: 99px;
        background: color-mix(in srgb, var(--teal) 12%, transparent);
        color: var(--fg); font-family: var(--font-d); font-weight: 700;
        font-size: .95rem; padding: 14px 30px; cursor: pointer;
        display: inline-flex; align-items: center; gap: 12px;
        transition: transform .15s, box-shadow .15s;
      }
      .d-play:hover { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(30,194,181,.25); }
      .d-play-tri { color: var(--teal); }
      .d-intro-meta { margin-top: 22px; font-family: var(--font-m); font-size: .68rem; color: var(--dim); letter-spacing: .08em; }

      /* ---------------- console shell ---------------- */
      .d-console { display: flex; flex-direction: column; height: 100vh; position: relative; z-index: 1; }
      .d-head {
        display: flex; align-items: center; gap: 22px;
        padding: 14px 26px; border-bottom: 1px solid var(--edge);
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: blur(8px);
      }
      .d-brand { font-weight: 800; font-size: 1.05rem; letter-spacing: .06em; }
      .d-brand span { color: var(--teal); font-weight: 500; }
      .d-head-paper { display: flex; align-items: baseline; gap: 12px; min-width: 0; flex: 1; }
      .d-head-tag {
        font-family: var(--font-m); font-size: .62rem; letter-spacing: .18em;
        color: var(--magenta); border: 1px solid color-mix(in srgb, var(--magenta) 45%, transparent);
        padding: 3px 9px; border-radius: 4px; white-space: nowrap;
      }
      .d-head-title { font-family: var(--font-m); font-size: .78rem; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .d-head-right { display: flex; align-items: center; gap: 14px; }
      .d-judge-chip {
        font-family: var(--font-m); font-size: .68rem; color: var(--teal);
        border: 1px solid var(--teal); padding: 4px 10px; border-radius: 99px;
      }
      .d-head-link { font-family: var(--font-m); font-size: .72rem; color: var(--dim); text-decoration: none; }
      .d-head-link:hover { color: var(--fg); }

      .d-grid {
        flex: 1; display: grid; grid-template-columns: 190px 1fr 220px;
        min-height: 0;
      }
      .d-rail {
        border-right: 1px solid var(--edge); padding: 18px 14px;
        display: flex; flex-direction: column; gap: 10px; min-height: 0;
      }
      .d-right { border-right: none; border-left: 1px solid var(--edge); justify-content: space-between; }

      /* agents */
      .d-agent {
        display: flex; flex-direction: column; gap: 2px;
        padding: 10px 12px; border: 1px solid var(--edge); border-radius: 10px;
        background: var(--card); transition: border-color .3s, box-shadow .3s, opacity .3s;
        opacity: .55;
      }
      .d-agent .a-name { font-family: var(--font-m); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
      .d-agent .a-name::before {
        content: ""; width: 7px; height: 7px; border-radius: 50%;
        background: var(--dim); transition: background .2s, box-shadow .2s;
      }
      .d-agent .a-sub { font-family: var(--font-m); font-size: .6rem; color: var(--dim); }
      .d-agent.active { opacity: 1; border-color: var(--teal); box-shadow: 0 0 22px color-mix(in srgb, var(--teal) 18%, transparent); }
      .d-agent.active .a-name::before { background: var(--teal); box-shadow: 0 0 8px var(--teal); animation: a-pulse 1s ease-in-out infinite; }
      .d-agent[data-agent="human"].active { border-color: var(--gold); box-shadow: 0 0 22px color-mix(in srgb, var(--gold) 20%, transparent); }
      .d-agent[data-agent="human"].active .a-name::before { background: var(--gold); box-shadow: 0 0 8px var(--gold); }
      @keyframes a-pulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
      .d-agent .a-last { font-family: var(--font-m); font-size: .58rem; color: var(--mut); margin-top: 4px; min-height: .9em; }

      /* stage */
      .d-center { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
      .d-stage {
        flex: 1; position: relative; overflow: hidden;
        display: flex; align-items: center; justify-content: center; padding: 30px;
      }
      .d-card {
        max-width: 640px; width: 100%;
        background: linear-gradient(160deg, color-mix(in srgb, var(--card) 88%, transparent), color-mix(in srgb, var(--bg2) 92%, transparent));
        border: 1px solid var(--edge); border-radius: 16px;
        padding: 30px 34px; position: relative;
        animation: card-in .45s cubic-bezier(.2,1.4,.3,1) both;
        box-shadow: 0 24px 80px rgba(0,0,0,.45);
      }
      @keyframes card-in {
        from { opacity: 0; transform: translateY(26px) scale(.96); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      .d-card.leaving { animation: card-out .3s ease both; }
      @keyframes card-out { to { opacity: 0; transform: translateY(-18px) scale(.97); } }
      .d-card .card-kick {
        font-family: var(--font-m); font-size: .62rem; letter-spacing: .2em;
        text-transform: uppercase; color: var(--dim); margin-bottom: 12px;
        display: flex; align-items: center; gap: 10px;
      }
      .d-card .card-kick .who { color: var(--teal); }
      .d-card h2 { font-size: clamp(1.3rem, 2.4vw, 1.9rem); font-weight: 800; letter-spacing: -0.01em; line-height: 1.15; margin-bottom: 12px; }
      .d-card p { color: var(--mut); font-size: .95rem; line-height: 1.6; }
      .d-card code, .d-card .mono { font-family: var(--font-m); }

      /* claim chips */
      .d-claimgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 18px; }
      .d-chip {
        border: 1px solid var(--edge); border-radius: 9px; padding: 10px 12px;
        background: color-mix(in srgb, var(--edge) 18%, transparent);
        animation: card-in .4s cubic-bezier(.2,1.4,.3,1) both;
      }
      .d-chip .ch-id { font-family: var(--font-m); font-size: .68rem; font-weight: 700; color: var(--blue); }
      .d-chip .ch-label { font-size: .72rem; color: var(--mut); line-height: 1.35; margin-top: 3px; }
      .d-chip .ch-kind { font-family: var(--font-m); font-size: .55rem; color: var(--dim); text-transform: uppercase; letter-spacing: .08em; }

      /* verdict stamps */
      .d-stamp {
        display: inline-block; font-family: var(--font-d); font-weight: 900;
        font-size: clamp(1.6rem, 3.4vw, 2.4rem); letter-spacing: .04em;
        text-transform: uppercase; padding: 6px 22px; margin-bottom: 14px;
        border: 3px solid; border-radius: 8px;
        animation: stamp-in .35s cubic-bezier(.3,1.8,.4,1) both;
      }
      @keyframes stamp-in {
        0% { opacity: 0; transform: scale(2.1) rotate(-8deg); }
        60% { opacity: 1; transform: scale(.94) rotate(3deg); }
        100% { transform: scale(1) rotate(-2deg); }
      }
      .d-stamp.supported { color: var(--teal); border-color: var(--teal); box-shadow: 0 0 40px color-mix(in srgb, var(--teal) 30%, transparent); }
      .d-stamp.falsified { color: var(--magenta); border-color: var(--magenta); box-shadow: 0 0 40px color-mix(in srgb, var(--magenta) 30%, transparent); }
      .d-stamp.inconclusive { color: var(--gold); border-color: var(--gold); box-shadow: 0 0 40px color-mix(in srgb, var(--gold) 30%, transparent); }
      .d-card.verdict-card { border-color: color-mix(in srgb, var(--edge) 60%, transparent); }

      /* strikes */
      .d-card.strike-card { border-color: color-mix(in srgb, var(--magenta) 35%, transparent); }
      .d-card.strike-card .card-kick .who { color: var(--magenta); }
      .strike-x {
        position: absolute; top: 24px; right: 26px;
        font-family: var(--font-m); font-weight: 900; font-size: 1.6rem;
        color: var(--magenta); animation: stamp-in .3s cubic-bezier(.3,1.8,.4,1) both;
      }
      .d-card.crash-card { border-color: color-mix(in srgb, var(--gold) 40%, transparent); }
      .d-card.crash-card .strike-x { color: var(--gold); }
      .d-card.crash-card .card-kick .who { color: var(--gold); }

      /* human / feedback */
      .d-card.human-card { border-color: color-mix(in srgb, var(--gold) 55%, transparent); box-shadow: 0 24px 80px rgba(0,0,0,.45), 0 0 30px color-mix(in srgb, var(--gold) 12%, transparent); }
      .d-card.human-card .card-kick .who { color: var(--gold); }
      .d-card .quote {
        border-left: 3px solid var(--gold); padding: 4px 0 4px 16px;
        color: var(--fg); font-size: 1rem; margin-top: 10px; font-style: italic;
      }

      /* generated hypothesis */
      .d-card.gen-card { border: 1px solid transparent; background:
        linear-gradient(var(--card), var(--card)) padding-box,
        var(--spectrum) border-box; }
      .gen-tag {
        font-family: var(--font-m); font-size: .6rem; letter-spacing: .16em;
        text-transform: uppercase; padding: 3px 10px; border-radius: 99px;
        background: var(--spectrum); color: var(--bg); font-weight: 700;
      }

      /* gate / lock */
      .d-card.gate-card { border-color: color-mix(in srgb, var(--violet) 55%, transparent); }
      .d-card.gate-card .card-kick .who { color: var(--violet); }
      .gate-lock { font-size: 1.4rem; }

      /* judge card */
      .d-card.judge-card { border-color: var(--teal); }
      .judge-rows { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; }
      .judge-row { display: flex; justify-content: space-between; font-family: var(--font-m); font-size: .72rem; color: var(--mut); }
      .judge-row b { color: var(--teal); }

      /* metric card */
      .d-card.metric-card { text-align: center; }
      .metric-big {
        font-size: clamp(3rem, 8vw, 5.4rem); font-weight: 900; letter-spacing: -0.03em;
        background: var(--spectrum); -webkit-background-clip: text; background-clip: text;
        color: transparent; line-height: 1; margin: 8px 0 14px;
      }

      /* ledger */
      .d-ledger {
        height: 128px; border-top: 1px solid var(--edge);
        overflow-y: auto; padding: 10px 26px;
        font-family: var(--font-m); font-size: .68rem; line-height: 1.9;
        color: var(--dim); scrollbar-width: thin;
        background: color-mix(in srgb, var(--bg) 70%, transparent);
      }
      .d-ledger .lg { display: flex; gap: 14px; white-space: nowrap; }
      .d-ledger .lg .lt { color: var(--dim); min-width: 44px; }
      .d-ledger .lg .la { min-width: 74px; }
      .d-ledger .lg .lm { color: var(--mut); overflow: hidden; text-overflow: ellipsis; }
      .d-ledger .lg.supported .lm { color: var(--teal); }
      .d-ledger .lg.falsified .lm { color: var(--magenta); }
      .d-ledger .lg.inconclusive .lm { color: var(--gold); }
      .d-ledger .lg.human .la { color: var(--gold); }

      /* loop tracker */
      .d-loop { display: flex; flex-direction: column; gap: 6px; }
      .d-loop .ph {
        font-family: var(--font-m); font-size: .62rem; letter-spacing: .12em;
        text-transform: uppercase; color: var(--dim);
        padding: 8px 10px; border-left: 2px solid var(--edge);
        transition: color .3s, border-color .3s;
      }
      .d-loop .ph.now { color: var(--fg); border-color: var(--blue); }
      .d-loop .ph.done { color: var(--mut); border-color: var(--teal); }
      .d-loop .ph.done::after { content: " ✓"; color: var(--teal); }
      .d-loop .ph .ph-n { color: var(--dim); margin-right: 6px; }
      .d-loop-head { font-family: var(--font-m); font-size: .58rem; letter-spacing: .2em; color: var(--dim); text-transform: uppercase; margin-bottom: 8px; }

      /* counters */
      .d-counters { display: flex; flex-direction: column; gap: 12px; }
      .d-counter { display: flex; flex-direction: column; }
      .d-counter-k { font-family: var(--font-m); font-size: 1.35rem; font-weight: 700; color: var(--fg); }
      .d-counter-v { font-family: var(--font-m); font-size: .56rem; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }

      /* timeline */
      .d-tl {
        display: flex; align-items: center; gap: 18px;
        padding: 14px 26px; border-top: 1px solid var(--edge);
        background: color-mix(in srgb, var(--bg) 85%, transparent);
      }
      .d-pp {
        appearance: none; width: 38px; height: 38px; border-radius: 50%;
        border: 1px solid var(--edge); background: var(--card); color: var(--teal);
        font-size: .8rem; cursor: pointer; display: grid; place-items: center;
        transition: transform .12s, border-color .12s;
      }
      .d-pp:hover { transform: scale(1.08); border-color: var(--teal); }
      .d-track { flex: 1; position: relative; height: 26px; cursor: pointer; }
      .d-track::before {
        content: ""; position: absolute; left: 0; right: 0; top: 50%;
        height: 5px; transform: translateY(-50%);
        background: color-mix(in srgb, var(--edge) 60%, transparent); border-radius: 3px;
      }
      .d-track-fill {
        position: absolute; left: 0; top: 50%; height: 5px; width: 0%;
        transform: translateY(-50%); border-radius: 3px;
        background: var(--spectrum);
      }
      .d-ticks { position: absolute; inset: 0; }
      .d-tick { position: absolute; top: 50%; width: 2px; height: 12px; transform: translate(-50%,-50%); background: var(--dim); border-radius: 1px; }
      .d-tick.major { height: 18px; background: var(--mut); }
      .d-tick.done { background: var(--teal); }
      .d-chapter {
        font-family: var(--font-m); font-size: .68rem; color: var(--gold);
        min-width: 210px; text-align: right; letter-spacing: .06em;
      }
      .d-clock { font-family: var(--font-m); font-size: .72rem; color: var(--mut); min-width: 90px; text-align: right; }

      /* finale overlay on stage */
      .d-finale { max-width: 780px; width: 100%; animation: card-in .5s ease both; }
      .d-finale h2 { font-size: 1.5rem; font-weight: 800; margin-bottom: 18px; }
      .fin-verdicts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 20px; }
      .fin-v { border: 1px solid var(--edge); border-radius: 10px; padding: 12px 14px; background: var(--card); position: relative; }
      .fin-v .fv-id { font-family: var(--font-m); font-size: .72rem; font-weight: 700; }
      .fin-v .fv-label { font-size: .68rem; color: var(--mut); margin: 4px 0 8px; min-height: 2.4em; }
      .fin-v .fv-verdict { font-family: var(--font-m); font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
      .fin-v .fv-note { font-family: var(--font-m); font-size: .56rem; color: var(--dim); margin-top: 4px; }
      .fin-v.supported { border-color: color-mix(in srgb, var(--teal) 50%, transparent); }
      .fin-v.supported .fv-verdict { color: var(--teal); }
      .fin-v.not_audited .fv-verdict { color: var(--dim); }
      .fin-v .gen-tag { position: absolute; top: -8px; right: 8px; font-size: .5rem; padding: 2px 7px; }
      .fin-metrics { display: flex; gap: 26px; flex-wrap: wrap; margin-bottom: 22px; }
      .fin-m .fm-k { font-family: var(--font-m); font-size: 1.5rem; font-weight: 700; background: var(--spectrum); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .fin-m .fm-v { font-family: var(--font-m); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); max-width: 150px; }
      .fin-links { display: flex; gap: 14px; flex-wrap: wrap; }
      .fin-links a {
        font-family: var(--font-m); font-size: .7rem; color: var(--mut);
        border: 1px solid var(--edge); border-radius: 8px; padding: 8px 14px; text-decoration: none;
        transition: color .15s, border-color .15s;
      }
      .fin-links a:hover { color: var(--fg); border-color: var(--teal); }

      @media (max-width: 900px) {
        .d-grid { grid-template-columns: 1fr; }
        .d-rail, .d-right { display: none; }
        .demo-body { overflow: auto; height: auto; }
        .d-console { height: auto; min-height: 100vh; }
        .d-ledger { height: 90px; }
      }
    </style>
    <script src="../demo.ts"></script>
    <ClipMenu />
  </body>
</html>
