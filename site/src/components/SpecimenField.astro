---
// SpecimenField — a persistent culture of motile particles that re-forms into
// a scientific motif per section. The specimen IS the data: the same culture
// becomes a helix for the mission, a petri dish for the approach, the
// double-descent curve for the findings, a lattice for the receipts, a
// constellation for the vision — then a colony, pipeline lanes, a seismograph.
// Sections declare their motif with data-specimen="<form>"; whichever element
// holds the viewport center band wins. Canvas2D, no deps, ~450 particles,
// prefers-reduced-motion renders one static frame.
---
<canvas id="specimen" aria-hidden="true"></canvas>

<style>
  #specimen {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    opacity: 0.55;
  }
</style>

<script>
  const canvas = document.getElementById("specimen") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const small = matchMedia("(max-width: 640px)").matches;
  if (!ctx) canvas?.remove();

  type V = { x: number; y: number };
  const N = small ? 240 : 460;
  const DPR = Math.min(devicePixelRatio || 1, 1.5);

  /* ---------- formations ---------- */
  // The content column owns the viewport center (~720px wrap), so motifs
  // render as margin specimens — two plates flanking the text, plus sparse
  // ambient drifters. Each formation returns n targets in css px.
  type Rect = { x: number; y: number; w: number; h: number };
  function plates(w: number, h: number): Rect[] {
    const content = Math.min(760, w * 0.72);
    const m = (w - content) / 2;
    if (m < 140) {
      // narrow screen: full-viewport faint scatter field instead
      return [{ x: 0, y: 0, w, h }];
    }
    return [
      { x: m * 0.08, y: h * 0.08, w: m * 0.84, h: h * 0.84 },
      { x: w - m * 0.92, y: h * 0.08, w: m * 0.84, h: h * 0.84 },
    ];
  }

  const FORMS: Record<string, (n: number, w: number, h: number) => V[]> = {
    // microscope slide — motile organisms drifting everywhere
    cloud(n, w, h) {
      return Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
      }));
    },

    // DNA — a vertical double helix coiling down each margin
    helix(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const narrow = ps.length === 1;
      const per = narrow ? n : Math.floor(n * 0.44);
      for (const p of ps) {
        const cx = p.x + p.w / 2;
        const A = p.w * 0.34;
        const turns = 2.6;
        const strandN = Math.floor(per * 0.33);
        for (let i = 0; i < strandN; i++) {
          const t = i / strandN;
          const y = p.y + t * p.h;
          const dx = Math.sin(t * Math.PI * 2 * turns) * A;
          pts.push({ x: cx - dx, y }, { x: cx + dx, y });
        }
        const rungN = Math.floor(per * 0.34);
        const rungs = 10;
        for (let r = 0; r < rungs && pts.length < per * (ps.indexOf(p) + 1); r++) {
          const t = (r + 0.5) / rungs;
          const y = p.y + t * p.h;
          const span = Math.abs(Math.sin(t * Math.PI * 2 * turns)) * A;
          for (let k = 0; k < Math.ceil(rungN / rungs); k++) {
            const u = (k + 0.5) / Math.ceil(rungN / rungs);
            pts.push({ x: cx - span + u * span * 2, y });
          }
        }
      }
      return fill(pts, n, w, h);
    },

    // petri dish — concentric rings + inner colonies, one per margin
    petri(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const per = Math.floor(n / ps.length);
      for (const p of ps) {
        const cx = p.x + p.w / 2, cy = p.y + p.h / 2;
        const R = Math.min(p.w, p.h) * 0.44;
        const ringN = Math.floor(per * 0.7);
        for (let i = 0; i < ringN; i++) {
          const ring = i % 3;
          const r = R * (0.55 + ring * 0.22);
          const a = (i / ringN) * Math.PI * 6 + ring;
          pts.push({ x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r });
        }
        const cols = [
          { x: -0.14, y: -0.1 }, { x: 0.16, y: 0.12 }, { x: -0.05, y: 0.18 }, { x: 0.1, y: -0.18 },
        ];
        for (let k = pts.length; k < per * (ps.indexOf(p) + 1); k++) {
          const c = cols[k % cols.length];
          pts.push({
            x: cx + c.x * R * 2.4 + (Math.random() - 0.5) * R * 0.22,
            y: cy + c.y * R * 2.4 + (Math.random() - 0.5) * R * 0.22,
          });
        }
      }
      return fill(pts, n, w, h);
    },

    // the double-descent risk curve — a small plot per margin
    curve(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const per = Math.floor(n / ps.length);
      for (const p of ps) {
        const x0 = p.x + p.w * 0.08, x1 = p.x + p.w * 0.92;
        const yBase = p.y + p.h * 0.72;
        const H = p.h * 0.5;
        const risk = (g: number) => {
          const spike = 0.55 * Math.exp(-Math.pow((g - 1) / 0.05, 2));
          const left = 0.5 - 0.24 * Math.min(g, 0.95);
          const right = 0.4 - 0.11 * Math.min(Math.max(g - 1, 0), 1);
          return (g < 1 ? left : right) + spike;
        };
        const curveN = Math.floor(per * 0.86);
        for (let i = 0; i < curveN; i++) {
          const t = i / curveN;
          pts.push({ x: x0 + t * (x1 - x0), y: yBase - risk(t * 1.7) * H });
        }
        // baseline + ticks
        for (let i = 0; i < 9 && pts.length < per * (ps.indexOf(p) + 1); i++) {
          const t = i / 8;
          pts.push({ x: x0 + t * (x1 - x0), y: yBase + 4 + (i % 2) * 6 });
        }
      }
      return fill(pts, n, w, h);
    },

    // ledger lattice — neat columns of accounted-for results in the margins
    grid(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const per = Math.floor(n / ps.length);
      for (const p of ps) {
        const cols = Math.max(4, Math.round(Math.sqrt(per * (p.w / p.h))));
        const rows = Math.ceil(per / cols);
        for (let i = 0; i < per; i++) {
          const c = i % cols, r = Math.floor(i / cols);
          pts.push({
            x: p.x + p.w * 0.08 + (c / Math.max(1, cols - 1)) * p.w * 0.84,
            y: p.y + p.h * 0.06 + (r / Math.max(1, rows - 1)) * p.h * 0.88,
          });
        }
      }
      return pts;
    },

    // constellation — clustered nodes with faint edges, one web per margin
    network(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const per = Math.floor(n / ps.length);
      const K = 6;
      for (const p of ps) {
        const cx = p.x + p.w / 2, cy = p.y + p.h / 2;
        for (let i = 0; i < per; i++) {
          const c = i % K;
          const a = (c / K) * Math.PI * 2;
          const nx = cx + Math.cos(a) * p.w * 0.34 + Math.sin(c * 7.3) * p.w * 0.06;
          const ny = cy + Math.sin(a) * p.h * 0.3 + Math.cos(c * 5.1) * p.h * 0.06;
          pts.push({
            x: nx + (Math.random() - 0.5) * p.w * 0.14,
            y: ny + (Math.random() - 0.5) * p.h * 0.1,
          });
        }
      }
      return pts;
    },

    // colonies — amoeba blobs in the margins amid sparse drifters
    colony(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const per = Math.floor(n / ps.length);
      for (const p of ps) {
        const blobs = [
          { x: 0.3, y: 0.24 }, { x: 0.68, y: 0.36 }, { x: 0.36, y: 0.62 }, { x: 0.7, y: 0.78 },
        ];
        for (let i = 0; i < per; i++) {
          if (i % 6 === 0) { pts.push({ x: Math.random() * w, y: Math.random() * h }); continue; }
          const b = blobs[i % blobs.length];
          const a = Math.random() * Math.PI * 2;
          const r = Math.pow(Math.random(), 0.5) * Math.min(p.w, p.h) * 0.16;
          pts.push({ x: p.x + b.x * p.w + Math.cos(a) * r, y: p.y + b.y * p.h + Math.sin(a) * r });
        }
      }
      return pts;
    },

    // pipeline lanes — vertical streams down each margin
    flow(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const per = Math.floor(n / ps.length);
      for (const p of ps) {
        for (let i = 0; i < per; i++) {
          const lane = i % 4;
          const t = (i / per) * 4;
          const y = p.y + (t - Math.floor(t)) * p.h;
          pts.push({
            x: p.x + p.w * (0.18 + lane * 0.21) + Math.sin(y * 0.014 + lane * 2.1) * p.w * 0.05,
            y,
          });
        }
      }
      return pts;
    },

    // seismograph — a waveform traced down each margin
    wave(n, w, h) {
      const pts: V[] = [];
      const ps = plates(w, h);
      const per = Math.floor(n / ps.length);
      const pulses = [0.14, 0.31, 0.38, 0.55, 0.62, 0.71, 0.83];
      for (const p of ps) {
        const cx = p.x + p.w / 2;
        for (let i = 0; i < per; i++) {
          const t = i / per;
          let v = 0;
          for (let q = 0; q < pulses.length; q++) {
            const d = (t - pulses[q]) * 40;
            v += Math.sin(d * 2.4 + q) * Math.exp(-d * d) * (q % 2 ? -1 : 1);
          }
          pts.push({ x: cx + v * p.w * 0.32, y: p.y + t * p.h });
        }
      }
      return pts;
    },
  };

  function fill(pts: V[], n: number, w: number, h: number): V[] {
    while (pts.length < n) pts.push({ x: Math.random() * w, y: Math.random() * h });
    return pts.slice(0, n);
  }

  /* ---------- particles ---------- */
  type P = {
    x: number; y: number;          // current
    sx: number; sy: number;        // morph start
    tx: number; ty: number;        // morph target
    t0: number; dur: number;       // morph timing
    jp: number; jf: number; jr: number; // jitter phase/freq/radius
    bucket: number;                // color bucket 0..3
    r: number;
  };

  const COLORS = [
    [125, 240, 196],  // teal
    [110, 200, 255],  // cyan
    [255, 110, 168],  // magenta
    [255, 200, 110],  // gold
  ];
  const BUCKET_W = [0.58, 0.24, 0.10, 0.08];
  function pickBucket() {
    const u = Math.random();
    let acc = 0;
    for (let i = 0; i < BUCKET_W.length; i++) { acc += BUCKET_W[i]; if (u < acc) return i; }
    return 0;
  }

  let W = 0, H = 0;
  let particles: P[] = [];
  let currentForm = "cloud";

  function resize() {
    W = innerWidth; H = innerHeight;
    canvas.width = Math.floor(W * DPR);
    canvas.height = Math.floor(H * DPR);
    ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function init() {
    resize();
    const targets = FORMS.cloud(N, W, H);
    particles = targets.map((t) => ({
      x: t.x, y: t.y, sx: t.x, sy: t.y, tx: t.x, ty: t.y,
      t0: 0, dur: 1,
      jp: Math.random() * Math.PI * 2,
      jf: 0.4 + Math.random() * 0.9,
      jr: 1.5 + Math.random() * 4.5,
      bucket: pickBucket(),
      r: 1.1 + Math.random() * 1.8,
    }));
  }

  function morphTo(form: string) {
    if (form === currentForm || !FORMS[form]) return;
    currentForm = form;
    const targets = FORMS[form](N, W, H);
    // random assignment — the swarm re-assembles, not a nearest-neighbor slide
    const order = targets.slice();
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }
    const now = performance.now() / 1000;
    particles.forEach((p, i) => {
      p.sx = p.x; p.sy = p.y;
      p.tx = order[i].x; p.ty = order[i].y;
      p.t0 = now + (i / N) * 0.9 + Math.random() * 0.45; // staggered swarm
      p.dur = 1.1 + Math.random() * 0.7;
    });
  }

  /* ---------- scroll velocity → turbulence ---------- */
  let lastY = scrollY, turb = 0;
  addEventListener("scroll", () => {
    const dy = Math.abs(scrollY - lastY);
    lastY = scrollY;
    turb = Math.min(1, turb + dy / 240);
  }, { passive: true });

  /* ---------- section → formation ---------- */
  {
    const seen = new Map<Element, string>();
    let active: { el: Element; form: string } | null = null;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const form = (e.target as HTMLElement).dataset.specimen!;
          if (e.isIntersecting) seen.set(e.target, form);
          else seen.delete(e.target);
        }
        // deepest element holding the center band wins (beats inside .story)
        let pick: string | null = null;
        let depth = -1;
        for (const [el, form] of seen) {
          const d = depthOf(el);
          if (d >= depth) { depth = d; pick = form; }
        }
        if (pick && pick !== (active?.form ?? currentForm)) morphTo(pick);
        active = pick ? { el: document.body, form: pick } : null;
      },
      { rootMargin: "-28% 0px -28% 0px", threshold: 0 },
    );
    function depthOf(el: Element) {
      let d = 0;
      while (el.parentElement) { d++; el = el.parentElement; }
      return d;
    }
    for (const el of document.querySelectorAll("[data-specimen]")) io.observe(el);
  }

  /* ---------- render ---------- */
  function frame(nowMs: number) {
    const now = nowMs / 1000;
    turb *= 0.94;
    ctx!.clearRect(0, 0, W, H);
    const jit = 1 + turb * 2.4;

    // network constellation edges first (under the dots)
    if (currentForm === "network") {
      ctx!.lineWidth = 0.6;
      ctx!.strokeStyle = "rgba(125,240,196,0.05)";
      ctx!.beginPath();
      for (let i = 0; i < particles.length; i += Math.floor(N / 8)) {
        const a = particles[i], b = particles[(i + Math.floor(N / 8)) % N];
        ctx!.moveTo(a.x, a.y); ctx!.lineTo(b.x, b.y);
      }
      ctx!.stroke();
    }

    for (const p of particles) {
      // morph progress (staggered cubic ease-out)
      const m = Math.min(1, Math.max(0, (now - p.t0) / p.dur));
      const e = 1 - Math.pow(1 - m, 3);
      const bx = p.sx + (p.tx - p.sx) * e;
      const by = p.sy + (p.ty - p.sy) * e;
      // perpetual motility — small orbits around the anchor
      const ja = p.jp + now * p.jf;
      p.x = bx + Math.cos(ja) * p.jr * jit;
      p.y = by + Math.sin(ja * 0.83) * p.jr * jit;

      const c = COLORS[p.bucket];
      const a = 0.24 + (p.bucket === 0 ? 0 : 0.14) + m * 0.06;
      ctx!.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${a.toFixed(3)})`;
      ctx!.beginPath();
      ctx!.arc(p.x, p.y, p.r * (0.8 + 0.4 * Math.sin(ja * 1.7)), 0, Math.PI * 2);
      ctx!.fill();
    }
  }

  if (ctx) {
    init();
    addEventListener("resize", () => {
      resize();
      // re-form the current motif at the new geometry
      const f = currentForm;
      currentForm = "__resize__";
      morphTo(f);
    });
    if (reduced) {
      frame(1000);
    } else {
      let raf = 0;
      const loop = (ms: number) => { frame(ms); raf = requestAnimationFrame(loop); };
      raf = requestAnimationFrame(loop);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(loop);
      });
    }
  }
</script>
