---
// Xylophone of audited claims — fully data-driven.
// Bars are flattened across ALL papers from papers.json; each paper gets one
// palette colour so bars visually group by paper while staying playable.
// Frequencies follow a C-major pentatonic scale (consonant in any order),
// cycled across the bar count so any number of papers still sounds right.
// Bar heights interpolate across the full range so N bars never overflow.
interface Bar {
  label: string;
  freq: number;
  state: "on" | "dim" | "fail";
  claim: string;
  slug: string;
  color: string;
}
interface Props {
  bars?: Bar[];
  /** reverse bar order (mirrored instrument at the page bottom) */
  mirrored?: boolean;
  /** readout element id — must be unique per instance */
  readoutId?: string;
}
let { bars, mirrored = false, readoutId = "xylo-readout" } = Astro.props;
let nPapers = 0;

if (!bars) {
  const data = await import("../data/papers.json");
  const papers = (data as { papers: Array<{ slug: string; xylo?: Array<{ label: string; claim: string; state?: string }> }> }).papers ?? [];
  nPapers = papers.length;
  const palette = ["c-blue", "c-magenta", "c-teal", "c-gold", "c-violet"];
  // C-major pentatonic across ~4 octaves (ascending).
  const scale = [
    261.63, 293.66, 329.63, 392.0, 440.0,
    523.25, 587.33, 659.25, 783.99, 880.0,
    1046.5, 1174.66, 1318.51, 1567.98, 1760.0,
    2093.0, 2349.32, 2637.02,
  ];
  const flat: Array<{ label: string; claim: string; state?: string; slug: string; color: string }> = [];
  papers.forEach((p, pi) => {
    const color = palette[pi % palette.length];
    for (const xb of p.xylo ?? []) {
      flat.push({ ...xb, slug: p.slug, color });
    }
  });
  const n = Math.max(1, flat.length - 1);
  bars = flat.map((b, i) => ({
    label: b.label,
    freq: scale[i % scale.length],
    state: (b.state as Bar["state"]) ?? "dim",
    claim: b.claim,
    slug: b.slug,
    color: b.color,
  }));
}

// Interpolate bar heights across the instrument range so any N fits.
if (mirrored) bars = [...bars].reverse();
const heights = bars.map((_, i) =>
  Math.round(34 + (i / Math.max(1, bars.length - 1)) * 160)
);
---

<div class="xylo" role="group" aria-label="Playable claim xylophone" data-bar-count={bars.length}>
  {
    bars.map((b, i) => (
      <button
        class={`bar ${b.state} ${b.color}`}
        style={`--h: ${heights[i]}px`}
        data-freq={b.freq}
        data-label={b.label}
        data-slug={b.slug}
        data-claim={b.claim}
        data-state={b.state}
        aria-label={`${b.slug} ${b.claim}: ${b.label} — ${b.state === "on" ? "supported" : b.state === "fail" ? "falsified" : "inconclusive"}`}
      >
        <span class="bar-label">{b.label}</span>
      </button>
    ))
  }
</div>
<p class="xylo-readout" id={readoutId}>
  {bars.length} bars · one per extracted claim across {nPapers} papers — click to play
</p>
