# Copy to .env and fill in real values.
# .env is gitignored — never commit real tokens.

# ─── Hugging Face ──────────────────────────────────────────────────────
# Access token: https://huggingface.co/settings/tokens
# Needs: read access (pull models/datasets), write access (push Spaces/logbooks).
HF_TOKEN=hf_your_token_here

# Your HF username (used for logbook publishing under your account)
HF_USERNAME=your-username

# ─── Modal ──────────────────────────────────────────────────────────────
# For GPU compute. Get tokens at: https://modal.com/settings/tokens
# Create a profile for this project: modal profile create lemma
# Then copy token_id + token_secret here, and run `modal token set` once.
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
MODAL_WORKSPACE=your-workspace-name

# ─── Trackio ───────────────────────────────────────────────────────────
# Trackio is published via Spaces under your HF account.
# Default project slug — used for `trackio logbook publish`.
TRACKIO_PROJECT=lemma

# ─── Coding agent (for Trackio agent traces) ──────────────────────────
# Optional: API key for the agent you'll use to drive reproductions.
# Trackio supports --claude, --cursor, --codex, --opencode, --pi.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
