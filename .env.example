# Copy to .env and fill in real values.
# .env is gitignored — never commit real tokens.

# ─── Hugging Face ──────────────────────────────────────────────────────
# Access token: https://huggingface.co/settings/tokens
# Needs: read access (pull models/datasets), write access (push Spaces/logbooks).
HF_TOKEN=hf_your_token_here

# Your HF username (used for logbook publishing under your account)
HF_USERNAME=your-username

# ─── HF GPU Jobs (primary compute path) ───────────────────────────────
# GPU compute runs on HF Jobs under your own namespace (e.g. Papajams).
# The challenge org does NOT grant job.write, so you must top up your
# own account at https://huggingface.co/settings/billing before the
# first GPU canary. Theory papers are exempt from the GPU-Job requirement,
# but empirical reproductions should record an HF Job URL per claim.
# Verify Jobs works for your account with:
#   hf jobs run python:3.12 python -c "print('ok')"          # CPU canary
#   hf jobs run --flavor t4 --timeout 3m python:3.12 \
#     python -c "import torch; print(torch.cuda.is_available())"   # GPU canary
# A 402 means add credits; a 403 means the token lacks job.write scope
# (regenerate the token at https://huggingface.co/settings/tokens).

# ─── Modal (optional, smoke tests only) ───────────────────────────────
# Only for local smoke tests; HF Jobs is the publish-grade compute path.
# Get tokens at https://modal.com/settings/tokens if you want to keep it.
# MODAL_TOKEN_ID=your_modal_token_id
# MODAL_TOKEN_SECRET=your_modal_token_secret
# MODAL_WORKSPACE=your-workspace-name

# ─── Trackio (>= 0.32.1) ───────────────────────────────────────────────
# Pip-installable:
#   uv venv .venv && .venv/bin/pip install -U "trackio>=0.32.1"
# Traces require Trackio 0.32.1+. Skipping the version pin breaks the
# `attach trace` subcommand used for the special awards.
TRACKIO_PROJECT=lemma

# ─── Paperclip (GXL, re:AGENT host tool) ──────────────────────────────
# 11M+ papers / FDA / trials / UniProt / PDB / ChEMBL. Lemma talks to the
# hosted MCP endpoint (https://paperclip.gxl.ai/mcp) directly over HTTP —
# no SDK needed (gxl_paperclip is not on PyPI).
# NOTE: the gxl_ hackathon key authenticates via the X-API-Key header on
# /mcp; the SDK-style Bearer token route does not accept it.
# agent/paperclip.py degrades to Firecrawl/arXiv when this is unset.
# PAPERCLIP_API_KEY=gxl_...

# ─── Firecrawl (literature search + PDF parsing, re:AGENT build) ──────
# agent/firecrawl.py works keyless for web search (arxiv.org indexing).
# With FIRECRAWL_API_KEY you also get:
#   - the life-science research index (41M+ papers) via /search sources=research
#   - cleaner PDF-to-markdown parsing for audit text extraction
# Key (optional): https://firecrawl.dev -> API keys
# FIRECRAWL_API_KEY=fc-your-key-here

# ─── Coding agent (for Trackio agent traces) ──────────────────────────
# The Trackio `attach trace` subcommand picks up whatever coding-agent
# transcript you point it at; the API key below is only needed if you
# also run that agent locally. Trackio supports --claude, --cursor,
# --codex, --opencode, --pi.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# ─── Lemma agent LLM provider stack (re:AGENT build) ──────────────────
# agent/llm.py tries providers in order; .env values OVERRIDE the shell
# environment (dotenv override=True), so a stale shell-env gateway key
# (e.g. an out-of-credits OPENAI_API_KEY) cannot hijack the run.
#
# Preferred: named OpenAI-compatible endpoints
#   LEMMA_ENDPOINTS=HF,ORCA          (order = priority)
#   LEMMA_<NAME>_API_KEY             (any string for keyless endpoints)
#   LEMMA_<NAME>_BASE_URL            (OpenAI-compatible /v1 URL)
#   LEMMA_<NAME>_MODEL               (model id, e.g. Qwen/Qwen3.8-27B)
#   LEMMA_<NAME>_EXTRA_BODY          (optional JSON: e.g. turn thinking off
#     so the model does not burn max_tokens on reasoning traces)
#
# Legacy single-provider fallbacks (tried after named endpoints):
#   ANTHROPIC_API_KEY   primary (hackathon Claude credits at the venue)
#   OPENAI_API_KEY / OPENAI_BASE_URL (or OPENAI_API_BASE) + OPENAI_MODEL
#
# Overrides: LEMMA_PROVIDER=<name> to force one provider; LEMMA_MODEL to
# force a model id across providers.
# Per-stage pin: LEMMA_<STAGE>_PROVIDER=<name> makes that stage prefer one
# provider (stages: EXTRACT, AUDIT, IMPROVE). E.g. LEMMA_IMPROVE_PROVIDER=WANDB
# keeps the reviewer-persona draft on the strongest endpoint while audits
# ride a cheaper one — reasoning effort is a cost knob, not a max setting.
#
# Thinking-mode endpoints (e.g. HF Qwen3.8-27B): set extra body to disable
# thinking, otherwise content can come back empty:
#   LEMMA_HF_EXTRA_BODY={"reasoning_effort": "none"}

# ─── W&B / Weave (CoreWeave Hacks build) ──────────────────────────────
# Key: https://wandb.ai/settings → API keys. When set, agent/weave_ops.py
# initialises Weave so every stage + LLM call is traced in the Weave UI,
# and `lemma eval` runs as a real Weave Evaluation. Unset = JSONL trace only,
# everything still works.
# WANDB_API_KEY=your-wandb-key
# LEMMA_WEAVE_PROJECT=lemma-audits      # optional, this is the default
# LEMMA_WEAVE=off                        # force-disable even with a key set
#
# W&B Inference as an LLM provider (OpenAI-compatible, $100 hackathon
# credits; see https://docs.wandb.ai/inference):
#   LEMMA_ENDPOINTS=WANDB
#   LEMMA_WANDB_API_KEY=<same value as WANDB_API_KEY>
#   LEMMA_WANDB_BASE_URL=https://api.inference.wandb.ai/v1
#   LEMMA_WANDB_MODEL=moonshotai/Kimi-K2.7-Code
#   LEMMA_WANDB_MAX_TOKENS=16384
# NOTE: reasoning models (DeepSeek-V4-*, gpt-oss-*) burn max_tokens on
# thinking and can return EMPTY content — the wrapper reads that as a
# provider failure and falls back. Always set LEMMA_WANDB_MAX_TOKENS as a
# floor. Kimi-K2.7-Code (1T-param agentic coding) is the best fit for
# writing audit scripts; deepseek-ai/DeepSeek-V4-Pro-0813 for the
# reviewer-persona calls if you want a different split.
